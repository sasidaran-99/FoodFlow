# ==============================================================================
# FoodFlow — Environment Configuration Template (.env.example)
# Copy this file to .env and configure appropriate values before running.
# NEVER commit the actual .env file to source control.
# ==============================================================================

# Database Credentials
DB_USER=foodflow
DB_PASSWORD=your_secure_database_password_here
DB_HOST=localhost
DB_PORT=5433

# JWT Secret Configuration
# Base64-encoded secret key for HMAC-SHA256 (minimum 256 bits / 32 bytes)
# Example generation command: openssl rand -base64 32
JWT_SECRET=your_base64_encoded_hmac_sha256_secret_key_minimum_256_bits_here

# Infrastructure Hosts & Ports
REDIS_HOST=localhost
REDIS_PORT=6379
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
ZOOKEEPER_PORT=2181

# Microservice URLs (Used by API Gateway)
USER_SERVICE_URL=http://localhost:8081
RESTAURANT_SERVICE_URL=http://localhost:8082
ORDER_SERVICE_URL=http://localhost:8083
PAYMENT_SERVICE_URL=http://localhost:8084
NOTIFICATION_SERVICE_URL=http://localhost:8085
DELIVERY_SERVICE_URL=http://localhost:8086

# API Gateway Port (Default 8080. If port 8080 is occupied by an external service like SynTrace, set to 8087)
GATEWAY_PORT=8080

# Frontend Configuration
# Matches API Gateway URL (e.g. http://localhost:8080 or http://localhost:8087)
VITE_API_BASE_URL=http://localhost:8080
